{
  "name": "mirror-windows",
  "version": "1.3.6",
  "private": true,
  "description": "Mirror Markdown editor for Windows",
  "main": "electron/main.cjs",
  "author": "Mirror contributors",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/prepare.cjs && vite build",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "playwright test",
    "test:updates-install": "node scripts/test-update-install.cjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64"
  },
  "devDependencies": {
    "dompurify": "^3.2.7",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^16.3.0",
    "mermaid": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@playwright/test": "^1.55.1",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.boneink.mirror.windows",
    "productName": "Mirror",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "Mirror-${version}-windows-${arch}-setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "Mirror-${version}-windows-${arch}-portable.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BoneInk/Mirror.git"
  }
}
